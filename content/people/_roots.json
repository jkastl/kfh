    "thomas-kastl-1806": {
      "name": "Thomas Kastl",
      "sex": "M",
      "branch": "roots",
      "facts": [
        {
          "type": "name",
          "value": "Thomas Kastl; also \"Tomas Kastl\"",
          "sources": [
            {
              "scan": "s009",
              "quote": "Their son Thomas (4). was born 15 September 1806, at Vsepadly."
            },
            {
              "scan": "s064",
              "quote": "Tomas Kastl, a widower, living in the village of Stara Hut, Bohemia, married Barbara Kellner 6 February 1855."
            }
          ]
        },
        {
          "type": "birth",
          "value": "15 September 1806, Všepadly, house No. 11, Bohemia",
          "sources": [
            {
              "scan": "s009",
              "quote": "was born 15 September 1806, at Vsepadly."
            },
            {
              "scan": "s016",
              "quote": "Thomas Kastl — 15 Sep 1806, Všepadly #11"
            }
          ]
        },
        {
          "type": "occupation",
          "value": "Farmer, near the village of Všepadly",
          "sources": [
            {
              "scan": "s009",
              "quote": "He became a farmer"
            },
            {
              "scan": "s043",
              "quote": "Thomas and Maria were farmers near the village of Vsepadly which is west and a little north Klatovy."
            }
          ]
        },
        {
          "type": "residence",
          "value": "Stara Hut, Bohemia, a widower, at his second marriage in 1855",
          "sources": [
            {
              "scan": "s064",
              "quote": "Tomas Kastl, a widower, living in the village of Stara Hut, Bohemia, married Barbara Kellner 6 February 1855. He was 48 years old, she was 26."
            }
          ]
        },
        {
          "type": "note",
          "value": "Father of the seven Kastl brothers who emigrated to America. The book says he fathered 14 children.",
          "sources": [
            {
              "scan": "s009",
              "quote": "These were the parents of the seven brothers who came to America in the 1800s."
            },
            {
              "scan": "s009",
              "quote": "According to the records, Thomas Kastl fathered 14 children; two in the second family died, one an infant, the other 6 years old."
            }
          ]
        }
      ]
    },
    "maria-marsalek": {
      "name": "Maria Marsalek",
      "sex": "F",
      "branch": "roots",
      "facts": [
        {
          "type": "name",
          "value": "Maria Marsalek; printed also \"Maraslek\" and \"Marselek\"",
          "sources": [
            {
              "scan": "s009",
              "quote": "the sons of a farmer, Thomas, and his wife Maria Maraslek."
            },
            {
              "scan": "s009",
              "quote": "married Maria, daughter of Joseph Marsalek, a magistrate manager at Kosenice, no. 33, on 30 January 1827."
            },
            {
              "scan": "s043",
              "quote": "Maria, the daughter of Joseph Marselek, a magistrate manager from Kosenice."
            }
          ]
        },
        {
          "type": "death",
          "value": "November 1853, at or soon after the birth of her youngest son, Andrew",
          "sources": [
            {
              "scan": "s009",
              "quote": "Maria Marsalek Kastl, mother of the seven brothers, died when Andrew, the youngest was born in November 1853."
            },
            {
              "scan": "s059",
              "quote": "Andrew was the last child of Maria who died soon after his birth."
            }
          ]
        },
        {
          "type": "note",
          "value": "A family story: knowing she could not live, she looked at her newborn son and said, \"Who will take care of you.\"",
          "sources": [
            {
              "scan": "s009",
              "quote": "(A story, handed down through the generations is that as the m other looked upon her newborn son, and knowing she could not live, said, \"Who will take care of you.\")"
            }
          ]
        }
      ]
    },
