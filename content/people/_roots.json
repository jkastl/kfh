    "eva-kastl": {
      "name": "Eva Kastl",
      "sex": "F",
      "branch": "roots",
      "uncertain": true,
      "facts": [
        {
          "type": "note",
          "value": "Possibly a daughter of Thomas and Maria. Named as a sister in Jacob Kastl's obituary, but the authors found nothing to verify her.",
          "sources": [
            {
              "scan": "s009",
              "quote": "There may have been a daughter, Eva. She is mentioned in the obituary of Jacob Kastl as a sister who preceded him in death. To date, nothing has been found to verify this."
            },
            {
              "scan": "s046",
              "quote": "Mr. Kastl had six brothers, Peter, Thomas, Joseph, Andrew, John, and Wencl, and one sister, Eva, all of whom passed away prior to the death of Grandpa Kastl."
            }
          ]
        }
      ]
    },
