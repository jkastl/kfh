            }
          ]
        },
        {
          "type": "note",
          "value": "26 years old at her marriage in 1855.",
          "sources": [
            {
              "scan": "s009",
              "quote": "he married 26 year old Barbara Kellner, daughter of Simon Kellner of Vsepadly."
            }
          ]
        },
        {
          "type": "note",
          "value": "A family story says she had been the girlfriend of Peter, Thomas's eldest son, while Peter was away with the Austrian Army.",
          "sources": [
            {
              "scan": "s009",
              "quote": "(Another story handed down is that Barbara had been the girlfriend of Peter, the eldest son of Thomas. But while Peter was off fighting with the Austrian Army, his father took her as his bride)."
            }
          ]
        }
