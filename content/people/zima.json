          "sources": [
            {
              "scan": "s064",
              "quote": "4. ANNA — (b) 12 Mar. 1865 at Stara Hut, House No. 3."
            },
            {
              "scan": "s064",
              "quote": "born 12 March 1865, in Stara Hut, Bohemia"
            }
          ]
        },
        {
          "type": "death",
          "value": "In Bohemia",
          "sources": [
            {
              "scan": "s064",
              "quote": "daughter of Thomas Kastl and Barbara Kellner, and died in Bohemia."
            }
          ]
        },
        {
          "type": "marriage",
          "value": "Joseph Zima, 1887, Bohemia",
          "sources": [
            {
              "scan": "s064",
              "quote": "She married Joseph Zima in Bohemia in 1887."
            }
          ]
        },
        {
          "type": "note",
          "value": "Half-sister of the seven brothers. Her son James Zima came to the United States in 1922.",
          "sources": [
            {
              "scan": "s064",
              "quote": "The fourth daughter, Anna, who was a half-sister to the seven Kastl brothers who settled in America, married Joseph Zima in Bohemia, in 1887. James Zima, a son of Anna and Joseph, did come to the United States in 1922."
            }
          ]
        }
      ]
